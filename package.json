{
  "name": "focus-pet",
  "version": "1.0.0",
  "description": "작업/공부 중 옆에서 집중하라고 알려주는 데스크탑 펫",
  "main": "main.js",
  "author": "YooBi Lee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoobilee/focus-pet.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test:invariants": "node test/sim-invariants.mjs",
    "test:movement-stats": "node test/sim-movement-stats.mjs",
    "test:render-poses": "node test/render-poses.mjs",
    "test:rotation-debug": "node test/sim-rotation-debug.mjs",
    "test:idle-rhythm": "node test/sim-idle-rhythm.mjs"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yoobi.focuspet",
    "productName": "FocusPet",
    "files": [
      "**/*",
      "!test/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.png",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/app-icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "identity": null
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
