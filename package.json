{
  "name": "focus-pet",
  "version": "1.0.0",
  "description": "작업/공부 중 옆에서 집중하라고 알려주는 데스크탑 펫",
  "main": "main.js",
  "author": "YooBi Lee",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yoobi.focuspet",
    "productName": "FocusPet",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/app-icon.png"
    }
  }
}
